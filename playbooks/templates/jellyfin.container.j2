[Unit]
Description=Jellyfin Media Server
After=network-online.target {{ required_mounts | join(' ') }}
Wants=network-online.target

[Container]
Image=docker.io/jellyfin/jellyfin:latest
ContainerName=jellyfin

# Config et cache
Volume={{ jellyfin_config_dir }}:/config:Z
Volume={{ jellyfin_cache_dir }}/cache:/cache:Z

# Médiathèques NAS
Volume={{ ansible_user_dir }}/nas/video:/media/video:ro
Volume={{ ansible_user_dir }}/nas/PlexMediaServer:/media/plex:ro

# Disque interne
Volume={{ ansible_user_dir }}/internes/exos/Videos:/media/exos:ro

Network=host
PublishPort=127.0.0.1:8096:8096

# Performance
Security=seccomp=unconfined
Environment=TZ=Europe/Paris

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target